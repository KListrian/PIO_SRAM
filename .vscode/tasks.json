{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Project",
      "type": "process",
      "command": "${userHome}/.pico-sdk/ninja/v1.12.1/ninja",
      "args": [
        "-C",
        "${workspaceFolder}/build"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1/ninja.exe"
      }
    },
    {
      "label": "Run Project",
      "type": "process",
      "command": "${env:HOME}/.pico-sdk/picotool/2.2.0-a4/picotool/picotool",
      "args": [
        "load",
        "${command:raspberry-pi-pico.launchTargetPath}",
        "-fx"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.2.0-a4/picotool/picotool.exe"
      }
    },
    {
      "label": "Flash",
      "type": "process",
      "isBuildCommand": true,
      "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
      "args": [
        "-s",
        "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
        "-f",
        "interface/cmsis-dap.cfg",
        "-f",
        "target/${command:raspberry-pi-pico.getTarget}.cfg",
        "-c",
        "adapter speed 5000; program \"${command:raspberry-pi-pico.launchTargetPath}\" verify reset exit"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe"
      }
    },
    {
      "label": "Rescue Reset",
      "type": "process",
      "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
      "args": [
        "-s",
        "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
        "-f",
        "interface/cmsis-dap.cfg",
        "-f",
        "target/${command:raspberry-pi-pico.getChip}-rescue.cfg",
        "-c",
        "adapter speed 5000; reset halt; exit"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe"
      }
    },
    {
      "label": "RISC-V Reset (RP2350)",
      "type": "process",
      "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
      "args": [
        "-s",
        "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
        "-c",
        "set USE_CORE { rv0 rv1 cm0 cm1 }",
        "-f",
        "interface/cmsis-dap.cfg",
        "-f",
        "target/rp2350.cfg",
        "-c",
        "adapter speed 5000; init;",
        "-c",
        "write_memory 0x40120158 8 { 0x3 }; echo [format \"Info : ARCHSEL 0x%02x\" [read_memory 0x40120158 8 1]];",
        "-c",
        "reset halt; targets rp2350.rv0; echo [format \"Info : ARCHSEL_STATUS 0x%02x\" [read_memory 0x4012015C 8 1]]; exit"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe"
      }
    },
    {
      "label": "Compile sram.asm",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "args": [
        "-f",
        "sram.asm",
        "-o",
        "sram.bin"
      ],
      "group": "build",
      "type": "process",
      "command": "c:/tmp/64tass.exe"
    },
    {
      "label": "Compile wozmon.asm",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "args": [
        "-f",
        "wozmon.asm",
        "-o",
        "sram.bin",
        "-l",
        "c:/tmp/wozmon.lst"
      ],
      "group": "build",
      "type": "process",
      "command": "c:/tmp/64tass.exe"
    },
    {
      "label": "Compile and Link wozmon.asm using cc65 toolchain",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build",
      "type": "shell",
      "command": "c:/tmp/ca65.exe wozmon.asm -o c:/tmp/wozmon.o && c:/tmp/ld65.exe c:/tmp/wozmon.o -C bios.cfg -o sram.bin -Ln c:/tmp/wozmon.lst"
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "Remove-Item",
      "args": [
        "-Recurse",
        "-Force",
        "${workspaceFolder}/build"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-Command",
          "Remove-Item -Recurse -Force '${workspaceFolder}/build'"
        ]
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Configure CMake",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-B",
        "${workspaceFolder}/build",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
  ]
}
