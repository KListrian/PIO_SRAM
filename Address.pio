
; Address PIO - reads address pins and pushes to RX FIFO
; 13 address pins for 8KB ROM + 2 status pins (GPIO 21 and GPIO 22)
; GPIO 22 is used as a Clock pin to synchronize sampling.

.program Address

.wrap_target
    wait 1 pin 14 [8]   ; Wait for Clock (GPIO 22) to go High (Offset 14 from GPIO 8)
    in pins, 15         ; Shift 15 bits (13 address + 2 status) from pins into ISR
    push block          ; Push to RX FIFO (blocking)
    wait 0 pin 14       ; Wait for Clock to go Low to prevent multiple samples in one cycle
.wrap

% c-sdk {

static inline void Address_program_init(PIO pio, uint sm, uint offset, uint pin)
{
    pio_sm_config c = Address_program_get_default_config(offset);

    sm_config_set_in_pins(&c, pin);          // set input pins base
    
    // Shift left (false) so data ends up in the lower bits (LSB)
    sm_config_set_in_shift(&c, false, false, 32);

    for (int i = 0; i < 15; i++)
    {
        pio_gpio_init(pio, pin + i);        // init so gpio is connected to pio
    }
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 15, false); // Set the GPIO pins as input

    pio_sm_init(pio, sm, offset, &c);        // Load our configuration
    pio_sm_set_enabled(pio, sm, true);      // Set the state machine running
}

%}
