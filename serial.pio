; Half-duplex serial PIO - sends and receives 8N1 UART-style serial data.
; TX/RX share one GPIO. Use one state machine for TX and one for RX.

.program serial
.side_set 1 opt pindirs

.wrap_target
    pull block side 0
    set x, 7 side 1 [7]    ; start bit: drive the shared line low
bitloop:
    out pindirs, 1 [6]     ; 8 data bits, LSB first: drive low for 0, release for 1
    jmp x-- bitloop
    nop side 0 [7]         ; stop bit: release the line high
.wrap

.program serial_rx

.wrap_target
    wait 0 pin 0           ; start bit
    set x, 7 [10]          ; sample near the middle of bit 0
bitloop:
    in pins, 1
    jmp x-- bitloop [6]    ; 8 cycles per data bit
    wait 1 pin 0           ; stop bit must be high before accepting the byte
    push block             ; byte is in bits 31:24
.wrap

% c-sdk {

static inline void serial_program_init(PIO pio, uint sm, uint offset, uint tx_pin, uint baud)
{
    pio_sm_config c = serial_program_get_default_config(offset);

    sm_config_set_sideset_pins(&c, tx_pin);
    sm_config_set_out_pins(&c, tx_pin, 1);
    sm_config_set_out_shift(&c, true, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    float div = (float)clock_get_hz(clk_sys) / (8.0f * (float)baud);
    sm_config_set_clkdiv(&c, div);

    pio_gpio_init(pio, tx_pin);
    gpio_pull_up(tx_pin);
    pio_sm_set_pins_with_mask(pio, sm, 0u, 1u << tx_pin);
    pio_sm_set_pindirs_with_mask(pio, sm, 0u, 1u << tx_pin);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline void serial_rx_program_init(PIO pio, uint sm, uint offset, uint rx_pin, uint baud)
{
    pio_sm_config c = serial_rx_program_get_default_config(offset);

    sm_config_set_in_pins(&c, rx_pin);
    sm_config_set_in_shift(&c, true, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    float div = (float)clock_get_hz(clk_sys) / (8.0f * (float)baud);
    sm_config_set_clkdiv(&c, div);

    pio_gpio_init(pio, rx_pin);
    gpio_pull_up(rx_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_pin, 1, false);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, false);
}

static inline void serial_program_set_tx_mode(PIO pio, uint tx_sm, uint rx_sm, uint pin)
{
    pio_sm_set_enabled(pio, rx_sm, false);
    pio_sm_set_pins_with_mask(pio, tx_sm, 0u, 1u << pin);
    pio_sm_set_pindirs_with_mask(pio, tx_sm, 0u, 1u << pin);
    pio_sm_set_enabled(pio, tx_sm, true);
}

static inline void serial_program_set_rx_mode(PIO pio, uint tx_sm, uint rx_sm, uint pin)
{
    pio_sm_set_enabled(pio, tx_sm, false);
    pio_sm_set_consecutive_pindirs(pio, rx_sm, pin, 1, false);
    pio_sm_clear_fifos(pio, rx_sm);
    pio_sm_restart(pio, rx_sm);
    pio_sm_set_enabled(pio, rx_sm, true);
}

static inline void serial_program_wait_tx_done(PIO pio, uint sm, uint baud)
{
    while (!pio_sm_is_tx_fifo_empty(pio, sm))
    {
        tight_loop_contents();
    }
    busy_wait_us((1000000u * 10u + baud - 1u) / baud);
}

static inline void serial_program_putc(PIO pio, uint sm, uint8_t data)
{
    pio_sm_put_blocking(pio, sm, (uint32_t)(uint8_t)~data);
}

static inline void serial_program_puts(PIO pio, uint sm, const char *s)
{
    while (*s)
    {
        serial_program_putc(pio, sm, (uint8_t)*s++);
    }
}

static inline int serial_rx_program_getc_timeout_us(PIO pio, uint sm, uint timeout_us)
{
    absolute_time_t deadline = make_timeout_time_us(timeout_us);
    while (pio_sm_is_rx_fifo_empty(pio, sm))
    {
        if (time_reached(deadline))
        {
            return -1;
        }
        tight_loop_contents();
    }

    return (int)(pio_sm_get(pio, sm) >> 24u);
}

static inline size_t serial_rx_program_gets(PIO pio, uint sm, char *buffer, size_t buffer_size, uint timeout_us)
{
    if (buffer_size == 0)
    {
        return 0;
    }

    size_t len = 0;
    while (len + 1 < buffer_size)
    {
        int ch = serial_rx_program_getc_timeout_us(pio, sm, timeout_us);
        if (ch < 0 || ch == '\r' || ch == '\n')
        {
            break;
        }
        buffer[len++] = (char)ch;
    }

    buffer[len] = '\0';
    return len;
}

%}
