.program Data
; The C code controls the flow. 
; For a Read cycle (Pico -> Bus), the C code starts a DMA that triggers 'pull'
; For a Write cycle (Bus -> Pico), the C code will need the SM to execute 'in'

public read_cycle:
    pull block
    out pins, 8         ; Drive 8 bits from OSR onto the data bus
    jmp read_cycle      ; Stay here until main loop forces a mode change

public write_cycle:
    wait 1 pin 14       ; Wait for Clock (GPIO 22) to go High (Offset 14 from GPIO 8)
    in pins, 8          ; Sample 8 bits from the data bus into ISR
    push block          ; Push the 8 bits to the RX FIFO for the DMA
    wait 0 pin 14       ; Wait for Clock to go Low to prevent multiple samples in one cycle
    jmp write_cycle     ; Stay here until main loop forces a mode change

% c-sdk {

// pio: the PIO instance (pio0 or pio1), sm: state machine index, offset: program start address, pin: GPIO number
static inline void Data_program_init(PIO pio, uint sm, uint offset, uint pin)
{
    pio_sm_config c = Data_program_get_default_config(offset);

    sm_config_set_out_pins(&c, pin, 8);     // set out pins 8 pins
    sm_config_set_in_pins(&c, pin);          // set in pins 8 pins

    // shift_right=true for 'out' (pull LSB first)
    // shift_right=false for 'in' (shift into LSB) so 8-bit DMA reads bits 0-7
    sm_config_set_out_shift(&c, true, false, 32);
    sm_config_set_in_shift(&c, false, false, 32);

    for (int i = 0; i < 8; i++)
    {
        pio_gpio_init(pio, pin + i);        // init so gpio is connected to pio
    }

    // Default to Input (false) to avoid bus contention on startup.
    // The main loop in PIO_SRAM.c will switch this to Output when needed.
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 8, false);

    pio_sm_init(pio, sm, offset, &c);       // Load our configuration, and jump to the start of the program
    pio_sm_set_enabled(pio, sm, true);      // Set the state machine running
}

%}
